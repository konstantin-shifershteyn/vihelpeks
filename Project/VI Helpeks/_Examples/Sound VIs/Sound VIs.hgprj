<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<VIHelpeksProject Version="3.1.0">

  <ProjectFiles>
    <Item Name="Sound File" Type="Group">
      <GroupRule>
        <Property Name="%Comments">The group defines common parameters for its members and their descendants.</Property>
        <Property Name="Source_Paths.PolyVI_Template">.</Property>
        <Property Name="Target_Paths.HTML_Dir">SoundFiles</Property>
      </GroupRule>
      <Item Type="File" URL="%menus%\Categories\Programming\_sound2\plat-sound2file.mnu"/>
    </Item>
    <Item Name="Sound Input" Type="Group">
      <GroupRule>
        <Property Name="%Comments">The group defines common parameters for its members and their descendants.</Property>
        <Property Name="Source_Paths.PolyVI_Template">.</Property>
        <Property Name="Target_Paths.HTML_Dir">SoundInput</Property>
      </GroupRule>
      <Item Type="File" URL="%menus%\Categories\Programming\_sound2\plat-sound2in.mnu"/>
    </Item>
    <Item Name="Sound Output" Type="Group">
      <GroupRule>
        <Property Name="%Comments">The group defines common parameters for its members and their descendants.</Property>
        <Property Name="Source_Paths.PolyVI_Template">.</Property>
        <Property Name="Target_Paths.HTML_Dir">SoundOutput</Property>
      </GroupRule>
      <Item Type="File" URL="%menus%\Categories\Programming\_sound2\plat-sound2out.mnu"/>
    </Item>
    <Item Type="File" URL="%menus%\Categories\Programming\_sound2\plat-sound2.mnu"/>
  </ProjectFiles>

  <ProductInfo>
    <Property Name="ProductName">VI Helpeks</Property>
    <Property Name="Website">https://github.com/konstantin-shifershteyn/vihelpeks</Property>
  </ProductInfo>

  <MasterRule>
    <Property Name="Build_Root_Dir">%temp%\VIHelpeks\output\Sound VIs</Property>
    <Property Name="BuildHelp">Enable</Property>
    <Property Name="VIDscrMode">Description1</Property>
    <Property Name="MenuDscrMode">Description</Property>
    <Property Name="MenuItemIcons">Enable</Property>
    <Property Name="Ctl_DscrMode">Description</Property>
    <Property Name="Ctl_ClustMembers">Enable</Property>
    <Property Name="Ctl_EnumValues">Enable</Property>
    <Property Name="%Comments">This example project demonstrates using file groups. Groups can be used for defining common parameters for its members and their descendants. In this example, groups are used to define target paths for output help files.\n\nThe Master Rule in this project is configured for generating help files that use JavaScripts ("Source Template File" and "Source CSS &amp; JS Files" categories). Resulting help files have framed layout similar to LabVIEW help.\n\nYou can easy reconfigure the project for generating flat (frameless) HTML files using "File&gt;&gt;Change project type" menu.\n</Property>
    <Property Name="PVIIDscrMode">None</Property>
    <Property Name="VIDetailsMode">Description2</Property>
    <Property Name="ProductInfoMode">Enable</Property>
    <Property Name="ProductInfoText">&lt;small&gt;&lt;b&gt;Disclaimer:&lt;/b&gt; This file has been generated by &lt;i&gt;&lt;b&gt;%PINF_PRODUCT%&lt;/b&gt;&lt;/i&gt; for demonstration its capabilities only. In no event this file can be considered, assumed or used as replacement to relevant VI or menu help comming with LabVIEW&lt;sup&gt;TM&lt;/sup&gt;.\n&lt;b&gt;Support:&lt;/b&gt; For more information or support on &lt;i&gt;&lt;b&gt;%PINF_PRODUCT%&lt;/b&gt;&lt;/i&gt;, visit %PINF_WEBSITE%&lt;/small&gt;</Property>
    <Property Name="Source_Paths.VI_Template">..\..\_Templates\JSBased\Help Template2 - VI.html</Property>
    <Property Name="Source_Paths.Menu_Template">..\..\_Templates\JSBased\Help Template2 - Menu.html</Property>
    <Property Name="Source_Paths.PolyVI_Template">..\..\_Templates\JSBased\Help Template2 - PolyVI.html</Property>
    <Property Name="Target_Paths.HTML_Dir">.</Property>
    <Property Name="Target_Paths.Image_Dir">image</Property>
    <Property Name="Target_Paths.CSS_Dir">css</Property>
    <Property Name="Target_Paths.JS_Dir">js</Property>
    <Property Name="Source_Paths.CSS_Files">
      <Item>..\..\_Templates\JSBased\default2.css</Item>
    </Property>
    <Property Name="Source_Paths.JS_Files">
      <Item>..\..\_Templates\JSBased\vih_frames.js</Item>
      <Item>..\..\_Templates\JSBased\vih_print.js</Item>
      <Item>..\..\_Templates\JSBased\vih_select.js</Item>
    </Property>
    <Property Name="Control_Rules">
      <Item>
        <Property Name="CtrlID">error in (no error)</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error in&lt;B&gt; cluster</Property>
        <Property Name="CustomName">error in</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error in&lt;B&gt; cluster</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error out&lt;B&gt; cluster</Property>
      </Item>
    </Property>
  </MasterRule>

  <ItemRules>
    <ItemRule ItemName="%menus%\Categories\Programming\_sound2\plat-sound2file.mnu">
      <Property Name="%Comments">This file presents in the project as both dynamic instance (descendant of "plat-sound2.mnu" palette) and static instance (member of "Sound File" group).\n</Property>
    </ItemRule>
    <ItemRule ItemName="%menus%\Categories\Programming\_sound2\plat-sound2in.mnu">
      <Property Name="%Comments">This file presents in the project as both dynamic instance (descendant of "plat-sound2.mnu" palette) and static instance (member of "Sound Input" group).\n</Property>
    </ItemRule>
    <ItemRule ItemName="%menus%\Categories\Programming\_sound2\plat-sound2out.mnu">
      <Property Name="%Comments">This file presents in the project as both dynamic instance (descendant of "plat-sound2.mnu" palette) and static instance (member of "Sound Output" group).\n</Property>
    </ItemRule>
    <ItemRule ItemName="%menus%\Categories\Programming\_sound2\plat-sound2.mnu">
      <Property Name="OutName">index.html</Property>
    </ItemRule>
  </ItemRules>

  <HHP_Generation>
    <Property Name="HHP_CreateTOC">TRUE</Property>
    <Property Name="HHP_CreateIDX">TRUE</Property>
  </HHP_Generation>

</VIHelpeksProject>
