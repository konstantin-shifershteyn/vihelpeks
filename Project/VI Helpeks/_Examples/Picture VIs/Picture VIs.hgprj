<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<VIHelpeksProject Version="3.1.0">

  <ProjectFiles>
    <Item Type="File" URL="%menus%\Categories\Programming\_graphics\pictureFuncs.mnu"/>
  </ProjectFiles>

  <ProductInfo>
    <Property Name="ProductName">VI Helpeks</Property>
    <Property Name="Website">https://github.com/konstantin-shifershteyn/vihelpeks</Property>
  </ProductInfo>

  <MasterRule>
    <Property Name="Build_Root_Dir">%temp%\VIHelpeks\output\Picture VIs</Property>
    <Property Name="BuildHelp">Enable</Property>
    <Property Name="VIDscrMode">Description1</Property>
    <Property Name="MenuDscrMode">Description</Property>
    <Property Name="MenuItemIcons">Enable</Property>
    <Property Name="Ctl_DscrMode">Description</Property>
    <Property Name="Ctl_ClustMembers">Enable</Property>
    <Property Name="Ctl_EnumValues">Enable</Property>
    <Property Name="%Comments">This example project demonstrates how you can define common description for identical controls in several VIs. In this example, control definition is made in the Master Rule; however, you can define or redefine control definition in groups as well as for every file individually. "Control Descriptions" category should be used for defining control descriptions.\n\nThe Master Rule in this project is configured for generating help files that use JavaScripts ("Source Template File" and "Source CSS &amp; JS Files" categories). Resulting help files have framed layout similar to LabVIEW help.\n\nYou can easy reconfigure the project for generating flat (frameless) HTML files using "File&gt;&gt;Change project type" menu.\n</Property>
    <Property Name="PVIIDscrMode">None</Property>
    <Property Name="VIDetailsMode">Description2</Property>
    <Property Name="ProductInfoMode">Enable</Property>
    <Property Name="ProductInfoText">&lt;small&gt;&lt;b&gt;Disclaimer:&lt;/b&gt; This file has been generated by &lt;i&gt;&lt;b&gt;%PINF_PRODUCT%&lt;/b&gt;&lt;/i&gt; for demonstration its capabilities only. In no event this file can be considered, assumed or used as replacement to relevant VI or menu help comming with LabVIEW&lt;sup&gt;TM&lt;/sup&gt;.\n&lt;b&gt;Support:&lt;/b&gt; For more information or support on &lt;i&gt;&lt;b&gt;%PINF_PRODUCT%&lt;/b&gt;&lt;/i&gt;, visit %PINF_WEBSITE%&lt;/small&gt;</Property>
    <Property Name="Source_Paths.VI_Template">..\..\_Templates\JSBased\Help Template2 - VI.html</Property>
    <Property Name="Source_Paths.Menu_Template">..\..\_Templates\JSBased\Help Template2 - Menu.html</Property>
    <Property Name="Source_Paths.PolyVI_Template">..\..\_Templates\JSBased\Help Template2 - PolyVI.html</Property>
    <Property Name="Target_Paths.HTML_Dir">.</Property>
    <Property Name="Target_Paths.Image_Dir">image</Property>
    <Property Name="Target_Paths.CSS_Dir">css</Property>
    <Property Name="Target_Paths.JS_Dir">js</Property>
    <Property Name="Source_Paths.CSS_Files">
      <Item>..\..\_Templates\JSBased\default2.css</Item>
    </Property>
    <Property Name="Source_Paths.JS_Files">
      <Item>..\..\_Templates\JSBased\vih_frames.js</Item>
      <Item>..\..\_Templates\JSBased\vih_print.js</Item>
      <Item>..\..\_Templates\JSBased\vih_select.js</Item>
    </Property>
    <Property Name="Control_Rules">
      <Item>
        <Property Name="CtrlID">error in (no error)</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error in&lt;B&gt; cluster</Property>
        <Property Name="CustomName">error in</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error in&lt;B&gt; cluster</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error out&lt;B&gt; cluster</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">pen</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">&lt;b&gt;pen&lt;/b&gt; sets the width and style of the pen the VI uses to draw the picture &lt;i&gt;(*** custom description from VI Helpeks project ***)&lt;/i&gt;\n</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">pen.Width</Property>
        <Property Name="CustomRule">TRUE</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">pen.Style</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="EnumValDscr">
          <EnumValue ID="0" STR="Solid">Solid style (default value) &lt;i&gt;(*** custom value description from VI Helpeks project ***)&lt;/i&gt;</EnumValue>
          <EnumValue ID="1" STR="Dash">Dash style &lt;i&gt;(*** custom value description from VI Helpeks project ***)&lt;/i&gt;</EnumValue>
          <EnumValue ID="2" STR="Dot">Dot style &lt;i&gt;(*** custom value description from VI Helpeks project ***)&lt;/i&gt;</EnumValue>
          <EnumValue ID="3" STR="DashDot">DashDot style &lt;i&gt;(*** custom value description from VI Helpeks project ***)&lt;/i&gt;</EnumValue>
          <EnumValue ID="4" STR="DashDotDot">DasDotDot style &lt;i&gt;(*** custom value description from VI Helpeks project ***)&lt;/i&gt;</EnumValue>
        </Property>
      </Item>
      <Item>
        <Property Name="CtrlID">rect</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">rect.left</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">&lt;b&gt;left&lt;/b&gt; is the horizontal coordinate of the left edge of the rectangle. &lt;i&gt;(*** custom description from VI Helpeks project ***)&lt;/i&gt;</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">rect.top</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">&lt;b&gt;top&lt;/b&gt; is the vertical coordinate of the top edge of the rectangle. &lt;i&gt;(*** custom description from VI Helpeks project ***)&lt;/i&gt;</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">rect.right</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">&lt;b&gt;right&lt;/b&gt; is the horizontal coordinate of the right edge of the rectangle. &lt;i&gt;(*** custom description from VI Helpeks project ***)&lt;/i&gt;</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">rect.bottom</Property>
        <Property Name="CustomRule">TRUE</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">&lt;b&gt;bottom&lt;/b&gt; is the vertical coordinate of the bottom edge of the rectangle. &lt;i&gt;(*** custom description from VI Helpeks project ***)&lt;/i&gt;\n</Property>
      </Item>
    </Property>
  </MasterRule>

  <HHP_Generation>
    <Property Name="HHP_CreateTOC">TRUE</Property>
    <Property Name="HHP_CreateIDX">TRUE</Property>
  </HHP_Generation>

</VIHelpeksProject>
