<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<VIHelpeksProject Version="3.1.0">

  <ProjectFiles>
    <Item Name="External Files" Type="Group">
      <GroupRule>
        <Property Name="%Comments">The file group contains non-LabVIEW files such as HTML and related files.\n</Property>
        <Property Name="Source_Paths.PolyVI_Template">.</Property>
      </GroupRule>
      <Item Type="File" URL="external files\css\3buttons.css"/>
      <Item Type="File" URL="external files\3buttons.html"/>
      <Item Type="File" URL="external files\image\3buttons_run.png"/>
      <Item Type="File" URL="external files\image\3buttons_use.png"/>
    </Item>
    <Item Type="File" URL="%vilib%\Utility\error.llb\Three Button Dialog.vi"/>
  </ProjectFiles>

  <ProductInfo>
    <Property Name="ProductName">VI Helpeks</Property>
    <Property Name="Website">https://github.com/konstantin-shifershteyn/vihelpeks</Property>
  </ProductInfo>

  <MasterRule>
    <Property Name="Build_Root_Dir">%temp%\VIHelpeks\output\3ButtonsDialogVI</Property>
    <Property Name="BuildHelp">Enable</Property>
    <Property Name="VIDscrMode">Description1</Property>
    <Property Name="MenuDscrMode">Description</Property>
    <Property Name="MenuItemIcons">Enable</Property>
    <Property Name="Ctl_DscrMode">Description</Property>
    <Property Name="Ctl_ClustMembers">Enable</Property>
    <Property Name="Ctl_EnumValues">Enable</Property>
    <Property Name="%Comments">This example project demonstrates:\n1) use of external HTML files in the project\n2) creating hypertext links between project files\n3) defining custom description for VIs\n4) defining custom description for VI controls and indicators\n5) defining value description for controls of Enum and Ring type.\n\nSee Comments for project files for more information...</Property>
    <Property Name="PVIIDscrMode">None</Property>
    <Property Name="VIDetailsMode">Description2</Property>
    <Property Name="ProductInfoMode">Enable</Property>
    <Property Name="ProductInfoText">&lt;small&gt;&lt;b&gt;Disclaimer:&lt;/b&gt; This file has been generated by &lt;i&gt;&lt;b&gt;%PINF_PRODUCT%&lt;/b&gt;&lt;/i&gt; for demonstration its capabilities only. In no event this file can be considered, assumed or used as replacement to relevant VI or menu help comming with LabVIEW&lt;sup&gt;TM&lt;/sup&gt;.\n&lt;b&gt;Support:&lt;/b&gt; For more information or support on &lt;i&gt;&lt;b&gt;%PINF_PRODUCT%&lt;/b&gt;&lt;/i&gt;, visit %PINF_WEBSITE%&lt;/small&gt;</Property>
    <Property Name="Source_Paths.VI_Template">..\..\_Templates\Default\Help Template - VI.html</Property>
    <Property Name="Source_Paths.Menu_Template">..\..\_Templates\Default\Help Template - Menu.html</Property>
    <Property Name="Source_Paths.PolyVI_Template">..\..\_Templates\Default\Help Template - PolyVI.html</Property>
    <Property Name="Target_Paths.HTML_Dir">.</Property>
    <Property Name="Target_Paths.Image_Dir">image</Property>
    <Property Name="Target_Paths.CSS_Dir">css</Property>
    <Property Name="Target_Paths.JS_Dir">js</Property>
    <Property Name="Source_Paths.CSS_Files">
      <Item>..\..\_Templates\Default\default.css</Item>
    </Property>
    <Property Name="Control_Rules">
      <Item>
        <Property Name="CtrlID">error in (no error)</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error in&lt;B&gt; cluster</Property>
        <Property Name="CustomName">error in</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error in</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error in&lt;B&gt; cluster</Property>
      </Item>
      <Item>
        <Property Name="CtrlID">error out</Property>
        <Property Name="DscrMode">Custom</Property>
        <Property Name="Description">standard &lt;B&gt;error out&lt;B&gt; cluster</Property>
      </Item>
    </Property>
  </MasterRule>

  <ItemRules>
    <ItemRule ItemName="%vilib%\Utility\error.llb\Three Button Dialog.vi">
      <Property Name="DscrMode">Custom</Property>
      <Property Name="Description">&lt;i&gt;(*** VI description is defined in VI Helpeks project ***)&lt;/i&gt;.\nDisplays a dialog box that contains a message and three buttons. &lt;a href="hprj:3buttons.html"&gt;&lt;b&gt;Click here&lt;/b&gt; to open HTML file with an example of use&lt;/a&gt;.\n</Property>
      <Property Name="%Comments">1) There are custom description and details defined for this VI (File Description category).\n2) VI description has a reference to "3buttons.html" file, which is replaced with hypertext link during building help, so output help file this VI has proper link to output file for "3buttons.html" (File Description category).\n3) There is custom description for some controls and indicators for this VI (Control Descriptions category).\n4) Controls and indicators of Enum and Ring types have custom description for every value  (Control Descriptions category).\n</Property>
      <Property Name="DetailsMode">Custom</Property>
      <Property Name="DetailsText">&lt;i&gt;(*** VI description is defined in VI Helpeks project ***)&lt;/i&gt;.\nIf you wire an empty string to a button text input, this VI hides that button. This allows you to convert a three button dialog box to a one or two button dialog box. For example, you could use this functionality to hide a Help button when no help is available. If you wire an empty string to all three button text inputs, this VI displays a dialog box with a single default OK button.\n</Property>
      <Property Name="Control_Rules">
        <Item>
          <Property Name="CtrlID">Justify Message (Left)</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="Left">Justify the text to the left &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
            <EnumValue ID="1" STR="Center">Center the text &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
            <EnumValue ID="2" STR="Right">Justify the text to the right &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">Which Button?</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="EnumValDscr">
            <EnumValue ID="0" STR="Left Button">Returned if the left button is clicked &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
            <EnumValue ID="1" STR="Center Button">Returned if the center button is clicked &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
            <EnumValue ID="2" STR="Right Button">Returned if the right button is clicked &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
            <EnumValue ID="3" STR="Window Close">Returned if a user closed the dialog &lt;i&gt;(*** value description is defined in VI Helpeks project ***)&lt;/i&gt;.</EnumValue>
          </Property>
        </Item>
        <Item>
          <Property Name="CtrlID">message</Property>
          <Property Name="CustomRule">TRUE</Property>
          <Property Name="DscrMode">Custom</Property>
          <Property Name="Description">&lt;b&gt;message&lt;/b&gt; is the text to display in the dialog box. &lt;i&gt;(*** Control description is defined in VI Helpeks project ***)&lt;/i&gt;.\n</Property>
        </Item>
      </Property>
    </ItemRule>
    <ItemRule ItemName="external files\3buttons.html">
      <Property Name="%Comments">The source HTML file. It has reference to "Three Button Dialog.vi" in its body in the form:\n    &lt;a href="hprj:Three Button Dialog.vi"&gt;Three Button Dialog VI&lt;/a&gt;\n\nDuring the build, this reference is replaced with actual hypertext link to output help file for the Three Button Dialog VI. Similary, description defined for the VI has a reference to this HTML file in order to create link to it.\n</Property>
    </ItemRule>
    <ItemRule ItemName="external files\css\3buttons.css">
      <Property Name="%Comments">This CSS file is referred in "3button.html" file. It is merely copied to the destination for CSS files defined in Target Paths category.\n</Property>
    </ItemRule>
    <ItemRule ItemName="external files\image\3buttons_run.png">
      <Property Name="%Comments">This image file is referred in "3button.html" file. It is merely copied to the destination for Image files defined in Target Paths category.\n</Property>
    </ItemRule>
    <ItemRule ItemName="external files\image\3buttons_use.png">
      <Property Name="%Comments">This image file is referred in "3button.html" file. It is merely copied to the destination for Image files defined in Target Paths category.\n</Property>
    </ItemRule>
  </ItemRules>

  <HHP_Generation>
    <Property Name="HHP_CreateTOC">TRUE</Property>
    <Property Name="HHP_CreateIDX">TRUE</Property>
  </HHP_Generation>

</VIHelpeksProject>
